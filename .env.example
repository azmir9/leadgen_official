# Copy to .env.local and replace every placeholder with your own local values.
MONGODB_URI=mongodb://127.0.0.1:27017/leadgen-official
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BOOTSTRAP_SECRET=replace-with-a-separate-random-secret
SUPER_ADMIN_NAME=Your Name
SUPER_ADMIN_USERNAME=your-admin-username
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# Public Worker registration resolves this configured owner identity's active workspace.
# Keep this equal to SUPER_ADMIN_USERNAME; do not set a workspace ID from browser input.
APP_URL=http://localhost:3000
# Admin online status inactivity threshold in minutes (1-1440; defaults to 15).
ADMIN_INACTIVITY_MINUTES=15
RESEND_API_KEY=re_placeholder
EMAIL_FROM=Leadgen Official <noreply@example.com>
